// The k8s-gpui default keymap.
//
// Defaults follow the Lens keymap. This file is the base for every platform; the macOS
// overlay in default-macos.json only adds the standard Command keys it needs.
// User overrides are loaded after this file.
//
// JSONC supports comments and trailing commas.
//
// Modifier families used below:
// - `secondary-shift-<key>` is the default family for app commands. Shift+letter survives
//   XKB, never collides with a Control+Alt+digit workspace switch, and does not shadow a
//   Control+letter readline binding inside a session.
// - `secondary-alt-<key>` is used where the mnemonic letter is free but the shift letter is
//   taken by another command or by the macOS overlay.
// - `alt-<key>` carries the status bar trio (pause, resume, appearance) and the cluster
//   switcher, because Control+Alt+d, l, q and t belong to the desktop shell and Alt+digit is
//   the chord every other Kubernetes client gives a context.
// - `ctrl-shift-<key>` is the session's own editing family, because that is what the terminal
//   reads from the modifier state. It appears only in the `Terminal` context.
//
// The two chords that had to be arbitrated, and the reasoning, so the next reader does not
// have to re-open the question:
//
// - **`secondary-shift-f` is resource search, and `secondary-f` is left unbound on purpose.**
//   The Dock answers `secondary-f` itself: `UI-SPEC` §16.3 names it find, and it is the chord
//   every other list on the desktop uses for find. A global binding here would take the key
//   away from the one surface that can act on it and hand it to a modal that appears over the
//   logs the reader was trying to search. The resource search is the cross-panel command, so
//   it takes the chord that has always meant "search everywhere" and is free on this layout,
//   which is the same place VS Code puts it. Nothing in this file may bind `secondary-f`;
//   an `unbind` row for it is as wrong as a binding, because it names a key no binding owns
//   and reads as a promise the app does not keep.
// - **`secondary-c` is copy in the table** (D10). It is scoped to `Table && !CommandPalette`
//   so a text surface, a session and the Inspector's value copy keep their own characters,
//   and it is released again in the `Editor || TextInput`, `Terminal` and overlay blocks.
//
// One rule produces every `unbind` block in this file: a chord the application owns is
// RELEASED on a surface that owns its own keyboard, so a focused session, a text surface, and
// a search field, a dialog or an open menu each keep the keys they are owed. Two consequences
// decide how a row is written:
// - A release names the action a surface takes back, so it must name the chord that action is
//   really bound on. `secondary-n` and `secondary-r` are the Inspector's Next Problem and
//   Revert now, so a Terminal row releasing the notification or kubeconfig command on them
//   would promise that the surface gives back a command that is not there.
// - An `unbind` row releases a binding loaded before it, so every release block below sits
//   under the `bindings` block it releases.
//
// A chord that appears once in a `bindings` block and three times in `unbind` blocks is one
// binding and three releases, not four bindings: a release names the action a surface takes
// back, and the list is the same list the Terminal comment above describes.
[
  {
    // Global bindings are available anywhere, including the command palette. The palette consumes keys before dispatch.
    // Tab and Shift+Tab move focus between regions when no more-specific context overrides them.
    //
    // `?` is bound in both the character and the shifted-key form because the two
    // platforms report Shift+slash differently: XKB names the resulting keysym `?`
    // with the shift bit still set, while other toolkits name the physical key `/`.
    // A shortcut reference is meant to be reachable from anywhere, so the pair is
    // one key with two spellings, and both are released again by the
    // Editor || TextInput, ResourceSearch || Dialog || PopupMenu, and Terminal
    // unbind blocks below so a text surface, an overlay, and a focused session
    // keep every character they are owed.
    "bindings": {
      "secondary-shift-p": "k8s_shell::ToggleCommandPalette",
      "?": "k8s_shell::OpenShortcutReference",
      "shift-?": "k8s_shell::OpenShortcutReference",
      "escape": "k8s_shell::Dismiss",
      "tab": "k8s_shell::FocusNext",
      "shift-tab": "k8s_shell::FocusPrevious",
      "ctrl-tab": "k8s_shell::FocusNext",
      "ctrl-shift-tab": "k8s_shell::FocusPrevious"
    }
  },
  {
    // Application shortcuts are explicitly unbound in terminal, search, dialog, and menu contexts.
    // Close has the same meaning on every platform: secondary-w closes the active window and
    // secondary-shift-t closes the active center tab, so one key never does two things.
    "context": "!CommandPalette",
    "bindings": {
      "secondary-w": "k8s_app::CloseWindow",
      "secondary-b": "k8s_shell::ToggleLeftPanel",
      "secondary-alt-b": "k8s_shell::ToggleRightPanel",
      "secondary-j": "k8s_shell::ToggleDock",
      "secondary-shift-f": "k8s_shell::SearchResources",
      "secondary-shift-n": "k8s_shell::ToggleNotifications",
      "secondary-shift-r": "k8s_shell::ReloadKubeconfigs",
      "secondary-,": "k8s_app::OpenSettings"
    }
  },
  {
    // The three switchers stay off a session. They open a modal picker over whatever the
    // session is showing, and a prompt is a place a person types rather than a surface the
    // shell may open a picker over, so the section itself excludes the Terminal instead of
    // releasing the chords there. They are still released on a text surface and on an
    // overlay below, where the same picker would cover the value being typed.
    "context": "Shell && !CommandPalette && !Terminal",
    "bindings": {
      "secondary-shift-c": "k8s_shell::OpenContextSwitcher",
      "secondary-shift-m": "k8s_shell::OpenNamespaceSwitcher",
      "secondary-shift-k": "k8s_shell::OpenResourceKindSwitcher"
    }
  },
  {
    // Every key in this section is released again by the Editor || TextInput,
    // ResourceSearch || Dialog || PopupMenu, and Terminal unbind blocks below, so a text
    // surface, an overlay, or a focused session always keeps its own keys.
    "context": "Shell && !CommandPalette",
    "bindings": {
      "secondary-alt-w": "k8s_shell::CloseOtherTabs",
      "secondary-shift-t": "k8s_shell::CloseTab",
      "secondary-shift-w": "k8s_shell::CloseAllTabs",
      "secondary-shift-i": "k8s_shell::TogglePinTab",
      "secondary-alt-left": "k8s_shell::MoveTabLeft",
      "secondary-alt-right": "k8s_shell::MoveTabRight",
      "secondary-pagedown": "k8s_shell::NextTab",
      "secondary-pageup": "k8s_shell::PreviousTab",
      "secondary-1": ["k8s_shell::SwitchTab", { "index": 0 }],
      "secondary-2": ["k8s_shell::SwitchTab", { "index": 1 }],
      "secondary-3": ["k8s_shell::SwitchTab", { "index": 2 }],
      "secondary-4": ["k8s_shell::SwitchTab", { "index": 3 }],
      "secondary-5": ["k8s_shell::SwitchTab", { "index": 4 }],
      "secondary-6": ["k8s_shell::SwitchTab", { "index": 5 }],
      "secondary-7": ["k8s_shell::SwitchTab", { "index": 6 }],
      "secondary-8": ["k8s_shell::SwitchTab", { "index": 7 }],
      "secondary-9": ["k8s_shell::SwitchTab", { "index": 8 }],
      // The Table and Inspector views open the selected object's YAML for editing.
      "secondary-e": "k8s_shell::FocusYaml",
      "secondary-shift-o": "k8s_shell::OpenOverview",
      // Commands on the current selection. The keys below are the historical keys that the
      // Terminal unbind block already reserved, so the release list and the bindings agree.
      "secondary-shift-a": "k8s_shell::ApplyYaml",
      "secondary-alt-e": "k8s_shell::OpenEvents",
      "secondary-alt-f": "k8s_shell::OpenForwards",
      "secondary-alt-i": "k8s_shell::DescribeSelection",
      "secondary-alt-r": "k8s_shell::RestartSelection",
      "secondary-alt-x": "k8s_shell::ExecSelection",
      "secondary-shift-g": "k8s_shell::PortForwardSelection",
      "secondary-shift-s": "k8s_shell::ScaleSelection",
      "secondary-shift-u": "k8s_shell::ReloadKeymap",
      "secondary-shift-v": "k8s_shell::OpenLogs",
      // Status bar and appearance commands. Alt keeps the mnemonic letter here: the shift
      // letters for p, r and t are taken, and Control+Alt+d, l, q and t belong to the desktop.
      "alt-p": "k8s_shell::PauseUpdates",
      "alt-r": "k8s_shell::ResumeUpdates",
      "alt-t": "k8s_shell::ToggleTheme",
      // Switching context. The cluster rail is gone, so the keys are bound here alone: it is
      // the shortcut a reader with six clusters cannot do without, and the digits are the
      // chord every other Kubernetes client gives a context. The run continues past the nine
      // digits, so a reader with more than nine contexts still has all of them on the
      // keyboard. The Terminal block below releases them, because a prompt is not the place
      // for a context switch and the keystroke is the session's.
      "alt-1": ["k8s_shell::SwitchCluster", { "index": 0 }],
      "alt-2": ["k8s_shell::SwitchCluster", { "index": 1 }],
      "alt-3": ["k8s_shell::SwitchCluster", { "index": 2 }],
      "alt-4": ["k8s_shell::SwitchCluster", { "index": 3 }],
      "alt-5": ["k8s_shell::SwitchCluster", { "index": 4 }],
      "alt-6": ["k8s_shell::SwitchCluster", { "index": 5 }],
      "alt-7": ["k8s_shell::SwitchCluster", { "index": 6 }],
      "alt-8": ["k8s_shell::SwitchCluster", { "index": 7 }],
      "alt-9": ["k8s_shell::SwitchCluster", { "index": 8 }],
      "alt-0": ["k8s_shell::SwitchCluster", { "index": 9 }],
      "alt--": ["k8s_shell::SwitchCluster", { "index": 10 }],
      "alt-=": ["k8s_shell::SwitchCluster", { "index": 11 }]
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "secondary-z": "k8s_shell::Undo",
      "secondary-shift-z": "k8s_shell::Redo",
      "secondary-x": "k8s_shell::Cut",
      "secondary-c": "k8s_shell::Copy",
      "secondary-v": "k8s_shell::Paste",
      "secondary-a": "k8s_shell::SelectAll"
    }
  },
  {
    // The filter field is the only TextInput in the app, and it sits inside the table, so
    // every bare key the table body answers is one keystroke away from a query being typed.
    // The Editor || TextInput block below releases the application chords for both text
    // surfaces; these are the table's own keys, named here as well because they are the ones
    // a reader is most likely to type: a space or an arrow key in a query is not a request to
    // open the selected row, and Delete in a query is not a request to destroy the resource
    // behind it. gpui-base happens to bind some of them on the Input element below this
    // surface, but that is a coincidence of the framework, not a guarantee.
    "context": "TextInput",
    "bindings": {
      "secondary-z": "k8s_shell::Undo",
      "secondary-shift-z": "k8s_shell::Redo",
      "secondary-x": "k8s_shell::Cut",
      "secondary-c": "k8s_shell::Copy",
      "secondary-v": "k8s_shell::Paste",
      "secondary-a": "k8s_shell::SelectAll"
    },
    "unbind": {
      "up": "k8s_table::SelectPrevious",
      "down": "k8s_table::SelectNext",
      "tab": "k8s_table::SelectNextColumn",
      "shift-tab": "k8s_table::SelectPreviousColumn",
      "enter": "k8s_table::OpenDetails",
      "space": "k8s_table::OpenDetails",
      "f5": "k8s_ops::Refresh",
      "delete": "k8s_ops::DeleteSelection",
      "secondary-shift-p": "k8s_shell::ToggleCommandPalette",
      "?": "k8s_shell::OpenShortcutReference",
      "shift-?": "k8s_shell::OpenShortcutReference",
      "escape": "k8s_shell::Dismiss",
      "ctrl-tab": "k8s_shell::FocusNext",
      "ctrl-shift-tab": "k8s_shell::FocusPrevious",
      "shift-enter": "k8s_table::SortSelectedColumn",
      "secondary-w": "k8s_app::CloseWindow",
      "secondary-alt-w": "k8s_shell::CloseOtherTabs"
    }
  },
  {
    // Resource table navigation bindings apply only when the table has focus.
    // Tab selects columns. Ctrl+Tab and Ctrl+Shift+Tab move focus out of the table.
    "context": "Table && !CommandPalette",
    "bindings": {
      "up": "k8s_table::SelectPrevious",
      "down": "k8s_table::SelectNext",
      "tab": "k8s_table::SelectNextColumn",
      "shift-tab": "k8s_table::SelectPreviousColumn",
      "shift-enter": "k8s_table::SortSelectedColumn",
      "enter": "k8s_table::OpenDetails",
      "space": "k8s_table::OpenDetails",
      "f5": "k8s_ops::Refresh",
      // Opens the row context menu. Shift+F10 is the keyboard route to the same menu that
      // the row button opens, so no command lives only behind a pointer.
      "shift-f10": "k8s_table::OpenRowActions",
      // The column-header popover prints this chord beside "Only problems", so the key
      // it shows is a key that works and the entry is not click-only.
      "alt-shift-p": "k8s_table::ToggleProblemsOnly",
      // Destructive action: opens a confirmation dialog.
      "delete": "k8s_ops::DeleteSelection",
      // D10: copy is Command+C. The chord is the one every other application on the desktop
      // uses for copying the thing under the cursor, and a data table is a list of names
      // whose whole purpose is to be pasted into a terminal. It is scoped to the table rather
      // than bound globally so a text surface and the Inspector's own value copy keep the
      // characters they are owed, and the Editor, TextInput, Terminal and overlay release
      // lists below give this one straight back.
      "secondary-c": "k8s_shell::CopySelectedPodName"
    }
  },
  {
    // Inspector tabs, the YAML review, and the Describe value rows. These keys belong to the panel,
    // not to the shell, because the panel is the only surface that can act on them. The Inspector is
    // a sibling of the Table, so f5 means Refresh in the table and Reload tab here.
    //
    // The review and the value keys are app keys, not panel-local inventions: each one takes a chord
    // this product already uses for the same idea, and the header families above say which letter is
    // free. Every key below is released again on a text surface and on an overlay, so typing and a
    // search field, a dialog, or a menu keep their own keys.
    "context": "Inspector && !CommandPalette",
    "bindings": {
      "secondary-alt-m": "k8s_inspector::MetricsRange1m",
      "secondary-shift-q": "k8s_inspector::MetricsRange15m",
      "secondary-shift-h": "k8s_inspector::MetricsRange1h",
      "secondary-alt-6": "k8s_inspector::MetricsRange6h",
      "secondary-alt-d": "k8s_inspector::MetricsRange24h",
      "secondary-alt-w": "k8s_inspector::MetricsRange7d",
      "f5": "k8s_inspector::ReloadActiveTab",
      // The r family is taken by Restart in the shell and by Reload kubeconfigs, so the
      // retry key takes the next free letter of the same family.
      "secondary-alt-c": "k8s_inspector::RetryMetrics",
      // Confirming the review writes to the cluster, so it is the power step of the apply flow and
      // not a bare key. secondary-shift-a already opens this review from the shell, and the two are
      // one flow, so the extra modifier complements a related shortcut rather than borrowing the
      // chord of an unrelated command. Alt is the family for a letter whose shift form is taken.
      "secondary-alt-a": "k8s_inspector::ConfirmApply",
      // Escape cancels the process in progress, and a review is a process in progress, so the panel
      // takes it here and releases the shell's global Dismiss in the next section.
      "escape": "k8s_inspector::CancelApplyReview",
      // Revert restores the text the cluster last reported, which is the reload direction this app
      // already spells secondary-shift-r, so it takes the plain r: the shell spells notifications
      // and kubeconfig reload in the shift family, which leaves the plain letters of this panel
      // free without a panel command inventing a shortcut of its own.
      "secondary-r": "k8s_inspector::RevertYaml",
      // n walks the parse-problem list, the way secondary-pagedown walks the tab bar.
      "secondary-n": "k8s_inspector::NextProblem",
      // Copying one field is the chord the value row already answers to, Control+c on Linux and
      // Command+c on macOS, so the keymap says the same thing and the panel route and the row route
      // cannot drift. The whole document then takes y, the letter that names the YAML this panel
      // owns: the c family is spoken for here, c is the value, shift-c the context switcher, and
      // alt-c the metrics retry.
      "secondary-c": "k8s_inspector::CopyValue",
      "secondary-y": "k8s_inspector::CopyYaml",
      // Expanding a truncated value is the least common command here, and the shift form of o is
      // OpenOverview in the shell, so the alt family carries it.
      "secondary-alt-o": "k8s_inspector::ToggleValueExpansion"
    }
  },
  {
    // A menu takes the keyboard back from the shell: these are the actions gpui-kit's
    // `PopupMenu` listens for, so escape and tab resolve here instead of falling through to
    // `k8s_shell::Dismiss` and `k8s_shell::FocusNext`.
    //
    // `PopupMenu` is the context gpui-kit's menu publishes on its focus handle, so that is the
    // name this section has to carry; nothing declares a `menu` context. `PopupMenu` binds
    // Up, Down and Escape to these actions itself, and the rows below are what this app adds
    // on top of that: Tab and Shift+Tab walk the list, because a menu takes them rather than
    // leaving the shell to move focus behind it.
    //
    // Home and End are not bound: `PopupMenu` handles neither `ui::SelectFirst` nor
    // `ui::SelectLast`, so naming them here would swallow the key and do nothing.
    //
    // Enter is not bound here either: `ui::Confirm` carries a payload and is declared
    // `no_json`, so a keymap cannot build it. `PopupMenu` binds Enter to that
    // action in its own context, which is where a menu actually is.
    "context": "PopupMenu",
    "bindings": {
      "up": "ui::SelectUp",
      "down": "ui::SelectDown",
      "tab": "ui::SelectDown",
      "shift-tab": "ui::SelectUp",
      "escape": "ui::Cancel"
    }
  },
  {
    // A focused session owns the keyboard: every app command that would preedit shell input or
    // move between tabs is unbound here, including the two close keys and the cluster chords.
    // Switching cluster is a shortcut a reader with six clusters cannot do without, and it is
    // a deliberate keypress, but a prompt is a place a person types, so the keystroke belongs
    // to the session and the shell does not answer it. Ctrl-Tab and Ctrl-Shift-Tab stay bound
    // as the focus escape out of the session.
    //
    // The editing keys are the ones the terminal reads from the modifier state:
    // Control+Shift+letter, because XKB folds Shift into the keysym and the printed character
    // cannot be trusted without costing every CapsLock user the interrupt. So Control+A,
    // Control+C, Control+V, Control+X and Control+F keep their readline meaning for the child
    // process. That one table also answers Control+Shift+F and Control+Shift+G with find and
    // find-next, and Shift+Insert with paste. None of the three is listed here: they are not
    // actions, the session answers them in its own key table, and a keymap file can only name an
    // action. The macOS overlay adds the Command chords, which the same table answers.
    //
    // `secondary-n` and `secondary-r` are not listed: the Inspector owns them now, so a row
    // here would promise the session gives back a command that is not bound on them.
    "context": "Terminal",
    "bindings": {
      "ctrl-shift-a": "k8s_shell::SelectAll",
      "ctrl-shift-c": "k8s_shell::Copy",
      "ctrl-shift-v": "k8s_shell::Paste",
      "ctrl-shift-x": "k8s_shell::Cut"
    },
    "unbind": {
      "escape": "k8s_shell::Dismiss",
      "tab": "k8s_shell::FocusNext",
      "shift-tab": "k8s_shell::FocusPrevious",
      "secondary-shift-p": "k8s_shell::ToggleCommandPalette",
      "?": "k8s_shell::OpenShortcutReference",
      "shift-?": "k8s_shell::OpenShortcutReference",
      "secondary-b": "k8s_shell::ToggleLeftPanel",
      "secondary-alt-b": "k8s_shell::ToggleRightPanel",
      "secondary-j": "k8s_shell::ToggleDock",
      "secondary-e": "k8s_shell::FocusYaml",
      "secondary-w": "k8s_app::CloseWindow",
      "secondary-shift-t": "k8s_shell::CloseTab",
      "secondary-alt-w": "k8s_shell::CloseOtherTabs",
      "secondary-shift-w": "k8s_shell::CloseAllTabs",
      "secondary-shift-i": "k8s_shell::TogglePinTab",
      "secondary-alt-left": "k8s_shell::MoveTabLeft",
      "secondary-alt-right": "k8s_shell::MoveTabRight",
      "secondary-pagedown": "k8s_shell::NextTab",
      "secondary-pageup": "k8s_shell::PreviousTab",
      "secondary-1": ["k8s_shell::SwitchTab", { "index": 0 }],
      "secondary-2": ["k8s_shell::SwitchTab", { "index": 1 }],
      "secondary-3": ["k8s_shell::SwitchTab", { "index": 2 }],
      "secondary-4": ["k8s_shell::SwitchTab", { "index": 3 }],
      "secondary-5": ["k8s_shell::SwitchTab", { "index": 4 }],
      "secondary-6": ["k8s_shell::SwitchTab", { "index": 5 }],
      "secondary-7": ["k8s_shell::SwitchTab", { "index": 6 }],
      "secondary-8": ["k8s_shell::SwitchTab", { "index": 7 }],
      "secondary-9": ["k8s_shell::SwitchTab", { "index": 8 }],
      // See the header: the resource search is the cross-panel command, so it takes the
      // chord that means "search everywhere" and leaves `secondary-f` to the Dock's find.
      "secondary-shift-f": "k8s_shell::SearchResources",
      "secondary-shift-n": "k8s_shell::ToggleNotifications",
      "secondary-shift-r": "k8s_shell::ReloadKubeconfigs",
      "secondary-shift-c": "k8s_shell::OpenContextSwitcher",
      "secondary-shift-m": "k8s_shell::OpenNamespaceSwitcher",
      "secondary-shift-k": "k8s_shell::OpenResourceKindSwitcher",
      "secondary-shift-o": "k8s_shell::OpenOverview",
      "secondary-,": "k8s_app::OpenSettings",
      "secondary-shift-a": "k8s_shell::ApplyYaml",
      "secondary-alt-e": "k8s_shell::OpenEvents",
      "secondary-alt-f": "k8s_shell::OpenForwards",
      "secondary-alt-i": "k8s_shell::DescribeSelection",
      "secondary-alt-r": "k8s_shell::RestartSelection",
      "secondary-alt-x": "k8s_shell::ExecSelection",
      "secondary-c": "k8s_shell::CopySelectedPodName",
      "secondary-shift-g": "k8s_shell::PortForwardSelection",
      "secondary-shift-s": "k8s_shell::ScaleSelection",
      "secondary-shift-u": "k8s_shell::ReloadKeymap",
      "secondary-shift-v": "k8s_shell::OpenLogs",
      "alt-p": "k8s_shell::PauseUpdates",
      "alt-r": "k8s_shell::ResumeUpdates",
      "alt-t": "k8s_shell::ToggleTheme",
      "alt-1": ["k8s_shell::SwitchCluster", { "index": 0 }],
      "alt-2": ["k8s_shell::SwitchCluster", { "index": 1 }],
      "alt-3": ["k8s_shell::SwitchCluster", { "index": 2 }],
      "alt-4": ["k8s_shell::SwitchCluster", { "index": 3 }],
      "alt-5": ["k8s_shell::SwitchCluster", { "index": 4 }],
      "alt-6": ["k8s_shell::SwitchCluster", { "index": 5 }],
      "alt-7": ["k8s_shell::SwitchCluster", { "index": 6 }],
      "alt-8": ["k8s_shell::SwitchCluster", { "index": 7 }],
      "alt-9": ["k8s_shell::SwitchCluster", { "index": 8 }],
      "alt-0": ["k8s_shell::SwitchCluster", { "index": 9 }],
      "alt--": ["k8s_shell::SwitchCluster", { "index": 10 }],
      "alt-=": ["k8s_shell::SwitchCluster", { "index": 11 }]
    }
  },
  {
    "context": "PopupMenu",
    "unbind": {
      "escape": "k8s_shell::Dismiss",
      "tab": "k8s_shell::FocusNext",
      "shift-tab": "k8s_shell::FocusPrevious",
      "ctrl-tab": "k8s_shell::FocusNext",
      "ctrl-shift-tab": "k8s_shell::FocusPrevious",
      "secondary-z": "k8s_shell::Undo",
      "secondary-shift-z": "k8s_shell::Redo",
      "secondary-x": "k8s_shell::Cut",
      "secondary-c": "k8s_shell::Copy",
      "secondary-v": "k8s_shell::Paste",
      "secondary-a": "k8s_shell::SelectAll"
    }
  },
  {
    // A text surface keeps the standard editing keys. Closing the window or a tab must never eat
    // a keystroke meant for the value being edited, and neither must the app commands that own
    // the end-of-line and tab keys. macOS releases the same keys from its overlay.
    //
    // A chord is a keystroke too, so the rest of the shell block above is released here as
    // well: Control+Shift+C cannot be typed as a character, and it still opened a modal
    // context picker over the YAML being typed. One keymap file maps one action per keystroke,
    // so a release that loses to another release on the same key names the panel command
    // rather than the shell one; that is why the table's copy and the Inspector's value copy
    // are released by the TextInput and overlay blocks instead. f5 is the same story: the
    // table's Refresh belongs to the filter field, which the TextInput block below releases,
    // and the Inspector's Reload belongs to the editor being typed in, which this one does.
    "context": "Editor || TextInput",
    "unbind": {
      "secondary-w": "k8s_app::CloseWindow",
