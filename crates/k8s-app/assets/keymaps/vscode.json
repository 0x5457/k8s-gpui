// The k8s-gpui "VS Code" keymap preset.
//
// The default keymap already speaks VS Code for everything both applications own: Ctrl+Shift+P
// opens the palette, Ctrl+Shift+F searches, Ctrl+, opens settings, Ctrl+W closes, Ctrl+B toggles
// the sidebar and Ctrl+J toggles the panel. Two chords were missing, they are added below, and
// the preset's whole content is those two plus the releases they need.
//
// It loads after the built-in defaults and the platform overlay and before the user keymap, so a
// user binding still wins.
//
// Ctrl+K chords and Ctrl+P quick open are absent because the product has no command behind them.
// Naming a chord the app cannot act on is worse than leaving the key free.
[
  {
    // Global bindings apply everywhere except while the modal command palette is open.
    "context": "!CommandPalette",
    "bindings": {
      // Ctrl+Shift+E is VS Code's Explorer and Ctrl+` its panel toggle.
      "secondary-shift-e": "k8s_shell::ToggleLeftPanel",
      "secondary-`": "k8s_shell::ToggleDock"
    }
  },
  {
    // The macOS overlay moves the sidebar and panel chords to Command+Shift+L and Command+Shift+D
    // so they do not collide with the desktop's own shortcuts. Neither of those is a VS Code
    // chord, so under this preset the reader would press both sets. Releasing them here is what
    // makes the pair above the only pair on every platform, and it costs nothing on Linux and
    // Windows, where the overlay is not loaded and these rows match no binding.
    "context": "!CommandPalette",
    "unbind": {
      "secondary-shift-l": "k8s_shell::ToggleLeftPanel",
      "secondary-shift-d": "k8s_shell::ToggleDock"
    }
  },
  {
    // A session, an overlay, and a text surface each own the keyboard, and these two chords open a
    // panel toggle rather than typing a character, so they are given back exactly where the
    // default keymap gives back its own.
    "context": "Terminal || ResourceSearch || Dialog || PopupMenu",
    "unbind": {
      "secondary-shift-e": "k8s_shell::ToggleLeftPanel",
      "secondary-`": "k8s_shell::ToggleDock"
    }
  },
  {
    "context": "Editor || TextInput",
    "unbind": {
      "secondary-shift-e": "k8s_shell::ToggleLeftPanel",
      "secondary-`": "k8s_shell::ToggleDock"
    }
  }
]
